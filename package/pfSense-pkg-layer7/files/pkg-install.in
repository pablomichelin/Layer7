#!/bin/sh

reload_filter() {
	_php="${PKG_ROOTDIR}/usr/local/bin/php"
	_filter_inc="${PKG_ROOTDIR}/etc/inc/filter.inc"

	if [ -x "${_php}" ] && [ -f "${_filter_inc}" ]; then
		"${_php}" -r "require_once('${_filter_inc}'); if (function_exists('filter_configure')) { filter_configure(); }" >/dev/null 2>&1 || true
	fi
}

if [ "${2}" != "POST-INSTALL" ]; then
	exit 0
fi

${PKG_ROOTDIR}/usr/local/bin/php -f ${PKG_ROOTDIR}/etc/rc.packages %%PORTNAME%% ${2}

# --- Config padrão (primeira instalação) ---
if [ ! -f "${PKG_ROOTDIR}/usr/local/etc/layer7.json" ] && [ -f "${PKG_ROOTDIR}/usr/local/etc/layer7.json.sample" ]; then
	cp "${PKG_ROOTDIR}/usr/local/etc/layer7.json.sample" "${PKG_ROOTDIR}/usr/local/etc/layer7.json"
fi

# Blacklists: sample → config.json na primeira instalacao (D6).
_bl_dir="${PKG_ROOTDIR}/usr/local/etc/layer7/blacklists"
_bl_cfg="${_bl_dir}/config.json"
_bl_sample="${_bl_dir}/config.json.sample"
if [ ! -f "${_bl_cfg}" ] && [ -f "${_bl_sample}" ]; then
	/bin/mkdir -p "${_bl_dir}"
	cp "${_bl_sample}" "${_bl_cfg}"
	chown www:wheel "${_bl_cfg}" 2>/dev/null || true
	chmod 0664 "${_bl_cfg}" 2>/dev/null || true
fi

if [ -f "${PKG_ROOTDIR}/usr/local/etc/layer7.json" ]; then
	chown www:wheel "${PKG_ROOTDIR}/usr/local/etc/layer7.json"
	chmod 0664 "${PKG_ROOTDIR}/usr/local/etc/layer7.json"
	# Migrar IDs amigaveis (lan/optN) gravados por versoes anteriores para
	# nomes reais consumidos por libpcap/PF (vmx0, igb1, vmx0.10, ...).
	"${PKG_ROOTDIR}/usr/local/bin/php" -r "
	require_once('${PKG_ROOTDIR}/etc/inc/config.inc');
	require_once('${PKG_ROOTDIR}/etc/inc/interfaces.inc');
	require_once('${PKG_ROOTDIR}/usr/local/pkg/layer7.inc');
	\$d = layer7_load_or_default();
	layer7_save_json(\$d);
	" >/dev/null 2>&1 || true
fi

if [ ! -f "${PKG_ROOTDIR}/usr/local/etc/layer7/profiles-custom.json" ]; then
	_profiles_bak="/tmp/layer7-profiles-custom.json.bak"
	if [ -f "${_profiles_bak}" ]; then
		/bin/mkdir -p "${PKG_ROOTDIR}/usr/local/etc/layer7"
		/bin/mv -f "${_profiles_bak}" "${PKG_ROOTDIR}/usr/local/etc/layer7/profiles-custom.json" 2>/dev/null || true
	else
		/bin/mkdir -p "${PKG_ROOTDIR}/usr/local/etc/layer7"
		printf '%s\n' '{"version":1,"overrides":{},"custom_profiles":[]}' \
			> "${PKG_ROOTDIR}/usr/local/etc/layer7/profiles-custom.json"
	fi
	chown www:wheel "${PKG_ROOTDIR}/usr/local/etc/layer7/profiles-custom.json" 2>/dev/null || true
	chmod 0664 "${PKG_ROOTDIR}/usr/local/etc/layer7/profiles-custom.json" 2>/dev/null || true
fi

/bin/mkdir -p "${PKG_ROOTDIR}/usr/local/etc/layer7/blacklists" \
	"${PKG_ROOTDIR}/usr/local/etc/layer7/blacklists/_custom"
chown www:wheel "${PKG_ROOTDIR}/usr/local/etc/layer7/blacklists" \
	"${PKG_ROOTDIR}/usr/local/etc/layer7/blacklists/_custom" 2>/dev/null || true
chmod 0775 "${PKG_ROOTDIR}/usr/local/etc/layer7/blacklists" \
	"${PKG_ROOTDIR}/usr/local/etc/layer7/blacklists/_custom" 2>/dev/null || true
if [ -f "${PKG_ROOTDIR}/usr/local/etc/layer7/blacklists/config.json" ]; then
	chown www:wheel "${PKG_ROOTDIR}/usr/local/etc/layer7/blacklists/config.json" 2>/dev/null || true
	chmod 0664 "${PKG_ROOTDIR}/usr/local/etc/layer7/blacklists/config.json" 2>/dev/null || true
fi

if [ ! -f "${PKG_ROOTDIR}/usr/local/etc/layer7-protos.txt" ] && [ -f "${PKG_ROOTDIR}/usr/local/etc/layer7-protos.txt.sample" ]; then
	cp "${PKG_ROOTDIR}/usr/local/etc/layer7-protos.txt.sample" "${PKG_ROOTDIR}/usr/local/etc/layer7-protos.txt"
fi

# --- Assets PF do pacote ---
if [ -x "${PKG_ROOTDIR}/usr/local/libexec/layer7-pfctl" ]; then
	"${PKG_ROOTDIR}/usr/local/libexec/layer7-pfctl" ensure
fi

reload_filter

# --- Directório de relatórios ---
/bin/mkdir -p "${PKG_ROOTDIR}/usr/local/etc/layer7/reports"

# --- Cron de recolha de stats (relatórios) ---
"${PKG_ROOTDIR}/usr/local/bin/php" -r "
require_once('${PKG_ROOTDIR}/etc/inc/filter.inc');
require_once('${PKG_ROOTDIR}/usr/local/pkg/layer7.inc');
layer7_reports_setup_cron(true, 5);
" >/dev/null 2>&1 || true

# --- Habilitar e (re)iniciar o serviço ---
# `onestart` sozinho nao substitui um layer7d ja em execução (upgrade deixa o
# binario antigo em memoria). Parar antes garante arranque com o pacote novo.
sysrc layer7d_enable=YES > /dev/null 2>&1
service layer7d onestop > /dev/null 2>&1 || true
service layer7d onestart > /dev/null 2>&1 || true

echo ""
echo "=== Layer7 instalado com sucesso ==="
echo "  Versão:  $(/usr/local/sbin/layer7d -V 2>/dev/null || echo '?')"
echo "  Config:  /usr/local/etc/layer7.json"
echo "  GUI:     Services > Layer 7"
echo ""
echo "  O pacote inicia em modo MONITOR (seguro)."
echo "  Acesse a GUI para configurar interfaces e políticas."
echo ""
echo "  Check-in online (30.14): instalacoes NOVAS usam check_in_enabled=true"
echo "  por defeito (sample). Upgrades NAO alteram o valor ja gravado."
echo "  Appliance isolado: defina check_in_enabled=false (GUI ou JSON)."
echo "  Falha de rede nao derruba enforce (N3). Runbook:"
echo "  docs/13-runbooks/check-in-migration-30.14.md"
echo ""
