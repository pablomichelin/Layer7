#!/bin/sh
#
# PROVIDES: layer7_tlsproxy
# REQUIRE: DAEMON NETWORKING
# KEYWORD: shutdown
#
# layer7-tlsproxy — helper MITM (20.10b). Default OFF.
# Upgrade NUNCA activa. Squid rejeitado.
# Arranque só com gate de produto escrito por PHP quando mitm_effective=true.

. /etc/rc.subr

name="layer7_tlsproxy"
rcvar="${name}_enable"
load_rc_config "${name}"

: "${layer7_tlsproxy_enable:=NO}"

pidfile="/var/run/layer7-tlsproxy.pid"
command="/usr/local/sbin/layer7-tlsproxy"
gatefile="/var/run/layer7/tlsproxy.product"

start_cmd="${name}_start"
stop_cmd="${name}_stop"
status_cmd="${name}_status"

layer7_tlsproxy_pid_from_file()
{
	_p=""
	[ -f "${pidfile}" ] || return 1
	if ! IFS= read -r _p <"${pidfile}" 2>/dev/null && [ -z "${_p}" ]; then
		_p=""
		return 1
	fi
	_p=$(printf '%s' "${_p}" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
	case "${_p}" in
	''|*[!0-9]*)
		_p=""
		return 1
		;;
	esac
	return 0
}

layer7_tlsproxy_start()
{
	checkyesno "${rcvar}" || return 0

	if [ ! -x "${command}" ]; then
		echo "${name}: binary missing (${command})" >&2
		return 1
	fi

	# 20.10b: gate escrito só quando mitm_effective (PHP). Sem gate = parado.
	if [ ! -f "${gatefile}" ]; then
		echo "${name}: mitm_effective gate absent — leaving service stopped" >&2
		return 1
	fi

	# 30.7 / GA2.9: rejeitar gate escrito à mão sem .lic assinado com mitm.
	# Root ainda pode contornar (R-A); fecha o caminho trivial A-07.
	if [ -x /usr/local/libexec/layer7-mitm-entitle-ok ]; then
		if ! /usr/local/libexec/layer7-mitm-entitle-ok; then
			echo "${name}: MITM entitlement check failed — refusing start" >&2
			return 1
		fi
	fi

	# shellcheck disable=SC1090
	. "${gatefile}"

	if [ -z "${LAYER7_TLSPROXY_LISTEN:-}" ] ||
	    [ -z "${LAYER7_TLSPROXY_CERT:-}" ] ||
	    [ -z "${LAYER7_TLSPROXY_KEY:-}" ]; then
		echo "${name}: incomplete product gate (${gatefile})" >&2
		return 1
	fi

	case "${LAYER7_TLSPROXY_LISTEN}" in
	127.0.0.1:*|::1:*)
		;;
	*)
		echo "${name}: refusing non-loopback listen (${LAYER7_TLSPROXY_LISTEN})" >&2
		return 1
		;;
	esac

	if [ ! -f "${LAYER7_TLSPROXY_CERT}" ] || [ ! -f "${LAYER7_TLSPROXY_KEY}" ]; then
		echo "${name}: CA cert/key missing" >&2
		return 1
	fi

	export LAYER7_TLSPROXY_PRODUCT=1
	_args="--product-listen ${LAYER7_TLSPROXY_LISTEN} --cert ${LAYER7_TLSPROXY_CERT} --key ${LAYER7_TLSPROXY_KEY}"
	if [ -n "${LAYER7_TLSPROXY_BLOCK_SNI:-}" ]; then
		# Multivalor: BLOCK_SNI="a.com b.com"
		for _sni in ${LAYER7_TLSPROXY_BLOCK_SNI}; do
			_args="${_args} --block-sni ${_sni}"
		done
	fi

	# -f: stdio -> /dev/null para o filho nao segurar pipes do activador PHP.
	/usr/sbin/daemon -f -p "${pidfile}" \
	    /usr/bin/env LAYER7_TLSPROXY_PRODUCT=1 \
	    ${command} ${_args}
	return $?
}

layer7_tlsproxy_stop()
{
	_p=""
	if [ -f "${pidfile}" ] && layer7_tlsproxy_pid_from_file; then
		:
	else
		_p=""
	fi
	/bin/rm -f "${pidfile}"
	[ -n "${_p}" ] && /bin/kill -TERM "${_p}" 2>/dev/null
	if [ -x /usr/bin/pkill ]; then
		/usr/bin/pkill -TERM -f "/usr/local/sbin/layer7-tlsproxy" 2>/dev/null || true
	fi
	return 0
}

layer7_tlsproxy_status()
{
	if [ -f "${pidfile}" ] && layer7_tlsproxy_pid_from_file && /bin/kill -0 "${_p}" 2>/dev/null; then
		echo "${name} is running as pid ${_p}."
		return 0
	fi
	echo "${name} is not running (default OFF; 20.10b gated)."
	return 1
}

run_rc_command "$1"
