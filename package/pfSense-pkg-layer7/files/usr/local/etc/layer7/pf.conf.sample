# Layer7 PF snippet (sample) — gerado pelo pacote em runtime via
# layer7_pf_default_rules_text() e por /usr/local/libexec/layer7-pfctl ensure.
#
# Este sample documenta o layout em modo ENFORCE com toggles default
# (block_dot_doq=false). Em monitor / desactivado, so as tabelas persistem.

table <layer7_block> persist
table <layer7_tagged> persist
table <layer7_block_dst> persist
table <layer7_allow_dst> persist

# Allowlist (Bloco 3): marca interna antes dos blocks Layer7. Nao cria
# autorizacao perante as regras nativas do pfSense.
match inet to <layer7_allow_dst> tag L7ALLOW label "layer7:allow:dst"

# Bloqueio por origem do cliente (quarentena/tag) — apenas destinos externos.
block drop quick inet from <layer7_block> to !<localsubnets> ! tagged L7ALLOW label "layer7:block:src"
block drop quick inet6 from <layer7_block> to !<localsubnets> ! tagged L7ALLOW label "layer7:block:src6"

# Bloqueio por destino (sites/apps bloqueados via policies / blacklists).
block drop quick inet to <layer7_block_dst> ! tagged L7ALLOW label "layer7:block:dst"
block drop quick inet6 to <layer7_block_dst> ! tagged L7ALLOW label "layer7:block:dst6"

# Anti-bypass DoT/DoQ (porta 853) e anti-QUIC (UDP 443) sao opcionais e
# controlados via GUI (Settings -> "Bloquear DoT / DoQ" e "Bloquear QUIC").
# Por defeito ambos OFF — activar so depois de validar em laboratorio.
