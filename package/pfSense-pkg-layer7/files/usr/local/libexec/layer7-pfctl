#!/bin/sh

set -eu

TABLE_BLOCK="layer7_block"
TABLE_TAGGED="layer7_tagged"
TABLE_BLOCK_DST="layer7_block_dst"
TABLE_ALLOW_DST="layer7_allow_dst"
RULES_DIR="/usr/local/etc/layer7"
RULES_PATH="${RULES_DIR}/pf.conf"
RULES_SAMPLE="${RULES_DIR}/pf.conf.sample"
BL_CONFIG="/usr/local/etc/layer7/blacklists/config.json"

scoped_enabled() {
	if [ ! -f /usr/local/etc/layer7.json ]; then
		echo 0
		return
	fi
	/usr/local/bin/php -r '
		$d = @json_decode(@file_get_contents("/usr/local/etc/layer7.json"), true);
		$em = isset($d["layer7"]["enforcement_model"])
		    ? (string)$d["layer7"]["enforcement_model"] : "legacy_global";
		echo ($em === "scoped_hybrid") ? "1" : "0";
	' 2>/dev/null || echo 0
}

table_referenced() {
	_table="$1"
	/sbin/pfctl -sr 2>/dev/null | /usr/bin/grep -Eq "<${_table}[:>]"
}

table_ready() {
	_table="$1"
	if /sbin/pfctl -s Tables 2>/dev/null | /usr/bin/grep -qw "$_table"; then
		return 0
	fi
	if table_referenced "$_table"; then
		return 0
	fi
	return 1
}

ensure_table() {
	_table="$1"
	if table_ready "$_table"; then
		return 0
	fi
	/sbin/pfctl -t "$_table" -T add 127.0.0.254 2>/dev/null && \
		/sbin/pfctl -t "$_table" -T delete 127.0.0.254 2>/dev/null && \
		return 0
	echo "layer7-pfctl: failed to ensure table ${_table}" >&2
	return 1
}

tables_missing() {
	for _t in "${TABLE_BLOCK}" "${TABLE_TAGGED}" "${TABLE_BLOCK_DST}" "${TABLE_ALLOW_DST}"; do
		if ! table_ready "$_t"; then
			return 0
		fi
	done
	return 1
}

required_tables_ok() {
	for _t in "${TABLE_BLOCK}" "${TABLE_TAGGED}" "${TABLE_BLOCK_DST}" "${TABLE_ALLOW_DST}"; do
		if ! table_ready "$_t"; then
			echo "layer7-pfctl: missing required table ${_t}" >&2
			return 1
		fi
	done
	if [ -f "${BL_CONFIG}" ]; then
		_count=$(/usr/local/bin/php -r '
			$c = @json_decode(@file_get_contents("'"${BL_CONFIG}"'"), true);
			echo isset($c["rules"]) ? count($c["rules"]) : 0;
		' 2>/dev/null)
		_idx=0
		while [ "$_idx" -lt "${_count:-0}" ]; do
			_t="layer7_bld_${_idx}"
			if ! table_ready "$_t"; then
				echo "layer7-pfctl: missing blacklist table ${_t}" >&2
				return 1
			fi
			_idx=$((_idx + 1))
		done
	fi
	if [ "$(scoped_enabled)" = "1" ]; then
		_idx=0
		while [ "$_idx" -lt 24 ]; do
			for _t in "layer7_pdst_${_idx}" "layer7_psrc_${_idx}"; do
				if ! table_ready "$_t"; then
					echo "layer7-pfctl: missing scoped table ${_t}" >&2
					return 1
				fi
			done
			_idx=$((_idx + 1))
		done
	fi
	_idx=0
	while [ "$_idx" -lt 24 ]; do
		_t="layer7_pallow_${_idx}"
		if ! table_ready "$_t"; then
			echo "layer7-pfctl: missing policy allow table ${_t}" >&2
			return 1
		fi
		_idx=$((_idx + 1))
	done
	return 0
}

force_reload_rules_debug() {
	_f=/tmp/rules.debug
	if [ ! -f "$_f" ]; then
		echo "layer7-pfctl: /tmp/rules.debug not found for fallback reload" >&2
		return 1
	fi
	# Recusar symlink / dono != root / world-writable (auditoria 1.9.9).
	if [ -L "$_f" ]; then
		echo "layer7-pfctl: refusing symlink /tmp/rules.debug" >&2
		return 1
	fi
	_uid=$(/usr/bin/stat -f %u "$_f" 2>/dev/null) || _uid=""
	if [ "$_uid" != "0" ]; then
		echo "layer7-pfctl: refusing untrusted owner on /tmp/rules.debug" >&2
		return 1
	fi
	_mode=$(/usr/bin/stat -f %OLp "$_f" 2>/dev/null) || _mode=""
	_other=$(( ${_mode:-0} % 10 ))
	if [ $((_other & 2)) -ne 0 ]; then
		echo "layer7-pfctl: refusing world-writable /tmp/rules.debug" >&2
		return 1
	fi
	/sbin/pfctl -f "$_f" 2>/dev/null || \
		echo "layer7-pfctl: failed to reload /tmp/rules.debug" >&2
}

ensure_blacklist_tables() {
	_rc=0
	if [ ! -f "${BL_CONFIG}" ]; then
		return 0
	fi
	_count=$(/usr/local/bin/php -r '
		$c = @json_decode(@file_get_contents("'"${BL_CONFIG}"'"), true);
		echo isset($c["rules"]) ? count($c["rules"]) : 0;
	' 2>/dev/null)
	_idx=0
	while [ "$_idx" -lt "${_count:-0}" ]; do
		ensure_table "layer7_bld_${_idx}" || _rc=1
		_idx=$((_idx + 1))
	done
	return "$_rc"
}

write_rules() {
	/bin/mkdir -p "${RULES_DIR}"
	_scoped=$(scoped_enabled)
	cat <<EOF > "${RULES_PATH}"
# Layer7 PF snippet (package-managed). Layout actual com allowlist (Bloco 3).
# Anti-bypass DoT/DoQ e anti-QUIC sao toggles na GUI; defeito OFF.
# NOTA: em pfSense CE o SSOT de regras activas e o hook layer7_generate_rules();
# este ficheiro e fallback/self-heal do daemon — nao substitui /tmp/rules.debug.
table <${TABLE_BLOCK}> persist
table <${TABLE_TAGGED}> persist
table <${TABLE_BLOCK_DST}> persist
table <${TABLE_ALLOW_DST}> persist
EOF
	_i=0
	while [ "${_i}" -lt 24 ]; do
		echo "table <layer7_pallow_${_i}> persist" >> "${RULES_PATH}"
		_i=$((_i + 1))
	done
	if [ "${_scoped}" = "1" ]; then
		cat <<'SCOPED' >> "${RULES_PATH}"

# scoped_hybrid (experimental): tabelas layer7_pdst_* / layer7_psrc_* sao
# geridas pelo hook PHP layer7_policy_enforcement_rules_text() em filter reload.
# layer7_pallow_* aplica allow positivo por politica em ambos os modelos.
# O ensure abaixo apenas garante persistencia das tabelas 0..23.
SCOPED
		_i=0
		while [ "${_i}" -lt 24 ]; do
			echo "table <layer7_pdst_${_i}> persist" >> "${RULES_PATH}"
			echo "table <layer7_psrc_${_i}> persist" >> "${RULES_PATH}"
			echo "table <layer7_pexc_${_i}> persist" >> "${RULES_PATH}"
			_i=$((_i + 1))
		done
	fi
	cat <<EOF >> "${RULES_PATH}"

# Allowlist: marca interna; nao autoriza trafego perante regras do pfSense.
match inet to <${TABLE_ALLOW_DST}> tag L7ALLOW label "layer7:allow:dst"

# Bloqueio por origem do cliente (quarentena/tag) — apenas destinos externos.
block drop quick inet from <${TABLE_BLOCK}> to !<localsubnets> ! tagged L7ALLOW label "layer7:block:src"
block drop quick inet6 from <${TABLE_BLOCK}> to !<localsubnets> ! tagged L7ALLOW label "layer7:block:src6"

# Bloqueio por destino (sites/apps bloqueados via policies/blacklists).
block drop quick inet to <${TABLE_BLOCK_DST}> ! tagged L7ALLOW label "layer7:block:dst"
block drop quick inet6 to <${TABLE_BLOCK_DST}> ! tagged L7ALLOW label "layer7:block:dst6"

# layer7_tagged permanece disponivel para regras manuais/encadeadas.
EOF

	if [ ! -f "${RULES_SAMPLE}" ]; then
		cp "${RULES_PATH}" "${RULES_SAMPLE}"
	fi
}

	# Nota: as regras rdr (block page :80 + DNS forcado :53) entram no
	# ruleset principal via layer7_generate_rules("nat") em layer7.inc
	# (hook filter_rule_function / discover_pkg_rules do pfSense). O anchor
	# natrules/layer7_nat e legado: nunca era avaliado para rdr.

flush_tables() {
	/sbin/pfctl -t "${TABLE_BLOCK}" -T flush >/dev/null 2>&1 || true
	/sbin/pfctl -t "${TABLE_TAGGED}" -T flush >/dev/null 2>&1 || true
	/sbin/pfctl -t "${TABLE_BLOCK_DST}" -T flush >/dev/null 2>&1 || true
}

# Tabelas layer7_bld_* (blacklist por IP) e excepcoes — necessario para remocao
# limpa e para evitar bloqueio residual apos pkg delete.
flush_tables_blacklist() {
	_i=0
	while [ "${_i}" -lt 32 ]; do
		/sbin/pfctl -t "layer7_bld_${_i}" -T flush >/dev/null 2>&1 || true
		/sbin/pfctl -t "layer7_blsrc_${_i}" -T flush >/dev/null 2>&1 || true
		_i=$((_i + 1))
	done
	/sbin/pfctl -t layer7_bl_except -T flush >/dev/null 2>&1 || true
}

# Tabelas por politica (block/allow — ate 24 politicas).
flush_tables_policy_scoped() {
	_i=0
	while [ "${_i}" -lt 24 ]; do
		/sbin/pfctl -t "layer7_pdst_${_i}" -T flush >/dev/null 2>&1 || true
		/sbin/pfctl -t "layer7_psrc_${_i}" -T flush >/dev/null 2>&1 || true
		/sbin/pfctl -t "layer7_pallow_${_i}" -T flush >/dev/null 2>&1 || true
		/sbin/pfctl -t "layer7_pexc_${_i}" -T flush >/dev/null 2>&1 || true
		_i=$((_i + 1))
	done
}

flush_tables_allow_dst() {
	/sbin/pfctl -t "${TABLE_ALLOW_DST}" -T flush >/dev/null 2>&1 || true
}

# Excepcoes allow por origem (estaticas no ruleset; flush evita indices orfaos).
flush_tables_exception_allow() {
	_i=0
	while [ "${_i}" -lt 16 ]; do
		/sbin/pfctl -t "layer7_exc_allow_${_i}" -T flush >/dev/null 2>&1 || true
		_i=$((_i + 1))
	done
}

flush_tables_all() {
	flush_tables
	flush_tables_blacklist
	flush_tables_exception_allow
	flush_tables_policy_scoped
	flush_tables_allow_dst
	# Residuos de lab (QA D5): ancora de teste G5 nao faz parte do ciclo
	# de vida do pacote — limpar se existir.
	/sbin/pfctl -a layer7_g5_test -F all >/dev/null 2>&1 || true
}

show_status() {
	echo "helper=/usr/local/libexec/layer7-pfctl"
	echo "rules=${RULES_PATH}"
	/sbin/pfctl -s Tables 2>/dev/null | grep "layer7_" || true
}

cmd="${1:-ensure}"
case "${cmd}" in
ensure)
		write_rules
		_rc=0
		ensure_table "${TABLE_BLOCK}" || _rc=1
		ensure_table "${TABLE_TAGGED}" || _rc=1
		ensure_table "${TABLE_BLOCK_DST}" || _rc=1
		ensure_table "${TABLE_ALLOW_DST}" || _rc=1
		ensure_blacklist_tables || _rc=1
		_i=0
		while [ "${_i}" -lt 24 ]; do
			ensure_table "layer7_pallow_${_i}" || _rc=1
			_i=$((_i + 1))
		done
		# Excepcoes allow / VIP (conteudo estatico e aplicado pelo PHP
		# layer7_static_origin_tables_apply_to_pf apos filter reload).
		_i=0
		while [ "${_i}" -lt 16 ]; do
			ensure_table "layer7_exc_allow_${_i}" || _rc=1
			_i=$((_i + 1))
		done
		_scoped=$(scoped_enabled)
		if [ "${_scoped}" = "1" ]; then
			_i=0
			while [ "${_i}" -lt 24 ]; do
				ensure_table "layer7_pdst_${_i}" || _rc=1
				ensure_table "layer7_psrc_${_i}" || _rc=1
				ensure_table "layer7_pexc_${_i}" || _rc=1
				_i=$((_i + 1))
			done
		fi
		if tables_missing; then
			echo "layer7-pfctl: required tables missing, trying rules.debug reload" >&2
			force_reload_rules_debug
		fi
		if ! required_tables_ok; then
			exit 1
		fi
		if [ "$_rc" -ne 0 ]; then
			echo "layer7-pfctl: recovered after ensure warnings" >&2
		fi
		;;
flush)
		flush_tables
		;;
flush-all)
		flush_tables_all
		;;
show)
		show_status
		;;
*)
		echo "usage: $0 [ensure|flush|flush-all|show]" >&2
		exit 1
		;;
esac
