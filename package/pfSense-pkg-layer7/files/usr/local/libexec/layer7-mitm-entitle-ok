#!/bin/sh
# layer7-mitm-entitle-ok — GA2.9 / passo 30.7 + P2-11 / M1 / BG-128
# Exit 0 se o .lic assinado concede mitm E o binding (HW + expiry/grace)
# corresponde ao contrato do daemon. Senão 1.
# HW local: layer7.inc chama /usr/local/sbin/layer7d --fingerprint
# (mesmo host/pkg; CLI one-shot, sem daemon em execução).
# Usado pelo rc.d layer7-tlsproxy. Root ainda pode patchar (R-A).
# Sem fallback só-assinatura: PHP + layer7.inc é o único caminho.

set -eu

INC="${LAYER7_INC:-/usr/local/pkg/layer7.inc}"

# rc.d PATH e so /sbin:/bin:/usr/sbin:/usr/bin — php vive em /usr/local/bin.
PHP_BIN=""
for _p in /usr/local/bin/php /usr/local/mds-php/bin/php; do
	if [ -x "$_p" ]; then
		PHP_BIN="$_p"
		break
	fi
done
if [ -z "$PHP_BIN" ] && command -v php >/dev/null 2>&1; then
	PHP_BIN=$(command -v php)
fi

if [ -z "$PHP_BIN" ] || [ ! -r "$INC" ]; then
	exit 1
fi

"$PHP_BIN" -r 'require $argv[1]; exit(layer7_has_entitlement("mitm") ? 0 : 1);' \
	"$INC"
