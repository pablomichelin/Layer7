#!/bin/sh
# layer7-install-ping — BG-162 / BG-163 / ADR-0036
# Inventário + POST fail-open. Exit 0 sempre (não parte pkg add / daemon).

INC="${LAYER7_INSTALL_PING_INC:-/usr/local/pkg/layer7-install-ping.inc}"
CLI="${LAYER7_INSTALL_PING_CLI:-/usr/local/pkg/layer7-install-ping-cli.php}"

PHP_BIN=""
for _p in /usr/local/bin/php /usr/local/sbin/php /usr/local/mds-php/bin/php; do
	if [ -x "$_p" ]; then
		PHP_BIN="$_p"
		break
	fi
done
if [ -z "$PHP_BIN" ] && command -v php >/dev/null 2>&1; then
	PHP_BIN=$(command -v php)
fi

if [ -z "$PHP_BIN" ] || [ ! -r "$INC" ] || [ ! -r "$CLI" ]; then
	exit 0
fi

export PATH="/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin${PATH:+:$PATH}"
export LAYER7_INSTALL_PING_INC="$INC"

INVENTORY=0
for _a in "$@"; do
	if [ "$_a" = "--inventory" ]; then
		INVENTORY=1
		break
	fi
done

if [ "$INVENTORY" -eq 1 ]; then
	"$PHP_BIN" -f "$CLI" -- --inventory
	exit $?
fi

"$PHP_BIN" -f "$CLI" >/dev/null 2>&1 || true
exit 0
