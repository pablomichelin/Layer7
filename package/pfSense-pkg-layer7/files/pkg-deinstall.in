#!/bin/sh

reload_filter() {
	_php="/usr/local/bin/php"
	_filter_inc="/etc/inc/filter.inc"

	if [ -x "${_php}" ] && [ -f "${_filter_inc}" ]; then
		"${_php}" -r "require_once('${_filter_inc}'); if (function_exists('filter_configure')) { filter_configure(); }" >/dev/null 2>&1 || true
	fi
}

layer7_remove_crontabs() {
	_php="/usr/local/bin/php"
	if [ ! -x "${_php}" ] || [ ! -f "/usr/local/pkg/layer7.inc" ]; then
		return 0
	fi
	"${_php}" -r "
require_once('/etc/inc/filter.inc');
require_once('/etc/inc/service-utils.inc');
require_once('/usr/local/pkg/layer7.inc');
if (function_exists('layer7_bl_setup_cron')) {
	layer7_bl_setup_cron(false, 24);
}
if (function_exists('layer7_reports_setup_cron')) {
	layer7_reports_setup_cron(false, 5);
}
if (function_exists('layer7_mitm_setup_window_cron')) {
	layer7_mitm_setup_window_cron(false);
}
" >/dev/null 2>&1 || true
}

# A1/A2: staging persistente privado (nunca /tmp). Segredos 0600.
# Se a preservação obrigatória (MITM CA / Identity secrets) falhar, não
# há rm/wipe de ${LAYER7_ETC_DIR:-/usr/local/etc}/layer7.
layer7_deinstall_init_paths() {
	_l7_etc="${LAYER7_ETC_DIR:-/usr/local/etc}"
	_l7_var_db="${LAYER7_VAR_DB_DIR:-/var/db}"
	_l7_stage="${LAYER7_PRESERVE_DIR:-${_l7_var_db}/layer7/deinstall-preserve}"
}

layer7_deinstall_secure_rm() {
	_p="$1"
	[ -n "${_p}" ] || return 0
	if [ -e "${_p}" ]; then
		chmod -R u+w "${_p}" 2>/dev/null || true
		/bin/rm -rf "${_p}"
	fi
}

layer7_deinstall_mandatory_present() {
	_etc_l7="${_l7_etc}/layer7"
	[ -d "${_etc_l7}/mitm" ] && return 0
	[ -f "${_etc_l7}/identity-ldap.secret" ] && return 0
	[ -f "${_etc_l7}/identity-radius.secret" ] && return 0
	[ -f "${_etc_l7}/identity-dc.secret" ] && return 0
	return 1
}

layer7_deinstall_stage_secrets() {
	_etc_l7="${_l7_etc}/layer7"
	_old_umask=$(umask)
	umask 077
	if ! /bin/mkdir -p "${_l7_stage}" 2>/dev/null; then
		umask "${_old_umask}"
		if layer7_deinstall_mandatory_present; then
			return 1
		fi
		return 0
	fi
	if ! chmod 0700 "${_l7_stage}"; then
		umask "${_old_umask}"
		return 1
	fi
	if [ -d "${_etc_l7}/mitm" ]; then
		/bin/rm -rf "${_l7_stage}/mitm"
		if ! /bin/cp -a "${_etc_l7}/mitm" "${_l7_stage}/mitm"; then
			umask "${_old_umask}"
			return 1
		fi
		[ -d "${_l7_stage}/mitm" ] || {
			umask "${_old_umask}"
			return 1
		}
		if [ -f "${_l7_stage}/mitm/ca.key" ]; then
			if ! chmod 0600 "${_l7_stage}/mitm/ca.key"; then
				umask "${_old_umask}"
				return 1
			fi
		fi
	fi
	for _s in identity-ldap.secret identity-radius.secret identity-dc.secret; do
		if [ -f "${_etc_l7}/${_s}" ]; then
			if ! /bin/cp -p "${_etc_l7}/${_s}" "${_l7_stage}/${_s}"; then
				umask "${_old_umask}"
				return 1
			fi
			if ! chmod 0600 "${_l7_stage}/${_s}"; then
				umask "${_old_umask}"
				return 1
			fi
			[ -f "${_l7_stage}/${_s}" ] || {
				umask "${_old_umask}"
				return 1
			}
		fi
	done
	if [ -f "${_etc_l7}/profiles-custom.json" ]; then
		/bin/cp -f "${_etc_l7}/profiles-custom.json" \
			"${_l7_stage}/profiles-custom.json" 2>/dev/null || true
	fi
	umask "${_old_umask}"
	return 0
}

layer7_deinstall_restore_secrets() {
	_etc_l7="${_l7_etc}/layer7"
	/bin/mkdir -p "${_etc_l7}" || return 1
	if [ -d "${_l7_stage}/mitm" ]; then
		/bin/rm -rf "${_etc_l7}/mitm"
		/bin/mv -f "${_l7_stage}/mitm" "${_etc_l7}/mitm" || return 1
		if [ -f "${_etc_l7}/mitm/ca.key" ]; then
			chmod 0600 "${_etc_l7}/mitm/ca.key" || return 1
		fi
	fi
	for _s in identity-ldap.secret identity-radius.secret identity-dc.secret; do
		if [ -f "${_l7_stage}/${_s}" ]; then
			/bin/mv -f "${_l7_stage}/${_s}" "${_etc_l7}/${_s}" || return 1
			chmod 0600 "${_etc_l7}/${_s}" || return 1
		fi
	done
	if [ -f "${_l7_stage}/profiles-custom.json" ]; then
		/bin/mv -f "${_l7_stage}/profiles-custom.json" \
			"${_etc_l7}/profiles-custom.json" 2>/dev/null || true
		chown www:wheel "${_etc_l7}/profiles-custom.json" \
			2>/dev/null || true
		chmod 0664 "${_etc_l7}/profiles-custom.json" 2>/dev/null || true
	fi
	return 0
}

# Contratos P1-6/P1-7/P1-8 (inalterados):
# upgrade / keep-config → preserva json/.lic + mitm + identity + /var/db
# keep-license → apaga json, mantém .lic + /var/db, wipe etc/layer7
# uninstall real → apaga json/.lic + etc/layer7 + /var/db leftovers
layer7_deinstall_etc_lifecycle() {
	layer7_deinstall_init_paths
	_preserve_runtime=0
	if [ "${_keep_config}" -eq 1 ] || [ "${_is_upgrade}" -eq 1 ]; then
		_preserve_runtime=1
	fi
	if [ "${_is_upgrade}" -eq 0 ]; then
		if [ "${_keep_config}" -eq 1 ]; then
			:
		elif [ "${_keep_license}" -eq 1 ]; then
			/bin/rm -f "${_l7_etc}/layer7.json" >/dev/null 2>&1 || true
		else
			/bin/rm -f "${_l7_etc}/layer7.json" \
				"${_l7_etc}/layer7.lic" >/dev/null 2>&1 || true
		fi
	fi
	if [ "${_preserve_runtime}" -eq 1 ]; then
		if ! layer7_deinstall_stage_secrets; then
			layer7_deinstall_secure_rm "${_l7_stage}"
			return 0
		fi
		/bin/rm -rf "${_l7_etc}/layer7"
		if ! layer7_deinstall_restore_secrets; then
			return 0
		fi
		layer7_deinstall_secure_rm "${_l7_stage}"
	else
		/bin/rm -rf "${_l7_etc}/layer7"
		layer7_deinstall_secure_rm "${_l7_stage}"
	fi
	if [ "${_is_upgrade}" -eq 0 ] && [ "${_keep_config}" -eq 0 ] && \
	    [ "${_keep_license}" -eq 0 ]; then
		/bin/rm -f "${_l7_var_db}/layer7-checkin.json" \
			"${_l7_var_db}/layer7/clock-mark.json" \
			"${_l7_var_db}/layer7/content-subscription.json" \
			>/dev/null 2>&1 || true
	fi
	return 0
}

if [ "${LAYER7_DEINSTALL_LIB:-}" = "1" ]; then
	return 0 2>/dev/null || exit 0
fi

# Parar o daemon enquanto o rc.d ainda existe (POST-DEINSTALL corre depois da remocao).
if [ "${2}" = "PRE-DEINSTALL" ]; then
	/usr/sbin/service layer7-blockpage onestop >/dev/null 2>&1 || true
	/usr/sbin/service layer7-tlsproxy onestop >/dev/null 2>&1 || true
	/bin/rm -f /var/run/layer7/tlsproxy.product /var/run/layer7/mitm.effective \
		/var/run/layer7-tlsproxy.pid >/dev/null 2>&1 || true
	if command -v sysrc >/dev/null 2>&1; then
		sysrc layer7_tlsproxy_enable=NO >/dev/null 2>&1 || true
	fi
	/usr/local/bin/php -r "
require_once('/etc/inc/config.inc');
require_once('/usr/local/pkg/layer7.inc');
if (function_exists('layer7_remove_unbound_blockpage')) {
	layer7_remove_unbound_blockpage();
}
if (function_exists('layer7_remove_unbound_vip_dns')) {
	layer7_remove_unbound_vip_dns();
}
" >/dev/null 2>&1 || true
	# P2-12: anti-DoH só em uninstall real (upgrade reaplicaria o bloco).
	if [ -z "${PKG_UPGRADE:-}" ]; then
		/usr/local/bin/php -r "
require_once('/etc/inc/config.inc');
require_once('/usr/local/pkg/layer7.inc');
if (function_exists('layer7_remove_unbound_anti_doh')) {
	layer7_remove_unbound_anti_doh();
}
" >/dev/null 2>&1 || true
	fi
	/usr/sbin/service layer7d onestop >/dev/null 2>&1 || true
	layer7_remove_crontabs
	if [ -x /usr/local/libexec/layer7-pfctl ]; then
		/usr/local/libexec/layer7-pfctl flush-all >/dev/null 2>&1 || true
	fi
fi

/usr/local/bin/php -f /etc/rc.packages %%PORTNAME%% ${2}

if [ "${2}" = "POST-DEINSTALL" ]; then
	/bin/rm -f /var/run/layer7d.pid >/dev/null 2>&1 || true
	if command -v sysrc >/dev/null 2>&1; then
		sysrc layer7d_enable=NO >/dev/null 2>&1 || true
	fi
	reload_filter
	# Fallback pos-remocao (helper ja ausente): alinhar com layer7-pfctl flush-all
	for _t in layer7_block layer7_block_dst layer7_tagged layer7_bl_except \
	    layer7_allow_dst layer7_mitm_src layer7_mitm_dst layer7_mitm_dst6; do
		/sbin/pfctl -t "${_t}" -T flush >/dev/null 2>&1 || true
	done
	/bin/rm -f /var/run/layer7/tlsproxy.product /var/run/layer7/mitm.effective \
		/var/run/layer7-tlsproxy.pid >/dev/null 2>&1 || true
	if command -v sysrc >/dev/null 2>&1; then
		sysrc layer7_tlsproxy_enable=NO >/dev/null 2>&1 || true
	fi
	_i=0
	while [ "${_i}" -lt 32 ]; do
		/sbin/pfctl -t "layer7_bld_${_i}" -T flush >/dev/null 2>&1 || true
		/sbin/pfctl -t "layer7_blsrc_${_i}" -T flush >/dev/null 2>&1 || true
		_i=$((_i + 1))
	done
	_i=0
	while [ "${_i}" -lt 16 ]; do
		/sbin/pfctl -t "layer7_exc_allow_${_i}" -T flush >/dev/null 2>&1 || true
		_i=$((_i + 1))
	done
	_i=0
	while [ "${_i}" -lt 24 ]; do
		/sbin/pfctl -t "layer7_pdst_${_i}" -T flush >/dev/null 2>&1 || true
		/sbin/pfctl -t "layer7_psrc_${_i}" -T flush >/dev/null 2>&1 || true
		/sbin/pfctl -t "layer7_pallow_${_i}" -T flush >/dev/null 2>&1 || true
		/sbin/pfctl -t "layer7_pexc_${_i}" -T flush >/dev/null 2>&1 || true
		_i=$((_i + 1))
	done

	_keep_config=0
	_keep_license=0
	_is_upgrade=0
	if [ -n "${PKG_UPGRADE:-}" ]; then
		_is_upgrade=1
	fi
	_l7_run="${LAYER7_RUN_DIR:-/var/run}"
	if [ -f "${_l7_run}/layer7-uninstall-keep-config" ]; then
		_keep_config=1
		/bin/rm -f "${_l7_run}/layer7-uninstall-keep-config"
	elif [ -f "${_l7_run}/layer7-uninstall-keep-license" ]; then
		_keep_license=1
		/bin/rm -f "${_l7_run}/layer7-uninstall-keep-license"
	fi
	# P1-8: upgrade nunca apaga json/.lic. Uninstall real honra keep-*.
	# A1: wipe de /usr/local/etc/layer7 só após staging obrigatório OK.
	layer7_deinstall_etc_lifecycle || true

	/bin/rm -f /usr/local/etc/layer7-protos.txt >/dev/null 2>&1 || true
	/bin/rm -f /var/log/layer7d.log /var/log/layer7-events.log \
		/var/log/layer7-bl-update.log >/dev/null 2>&1 || true
	_i=1
	while [ "${_i}" -le 10 ]; do
		/bin/rm -f "/var/log/layer7d.log.${_i}" \
			"/var/log/layer7-events.log.${_i}" >/dev/null 2>&1 || true
		_i=$((_i + 1))
	done
	/bin/rm -f /tmp/layer7-stats.json /var/db/layer7/layer7-stats.json \
		/var/db/layer7/layer7-stats.json.tmp \
		/var/db/layer7/bl-progress.txt \
		/tmp/layer7-bl-progress.txt /tmp/layer7-bl-update.lock \
		/tmp/layer7-gh-latest.json /tmp/layer7-ndpi-protos.json \
		/var/db/layer7/gh-latest.json /var/db/layer7/ndpi-protos.json \
		/tmp/layer7_pkg_rm_started >/dev/null 2>&1 || true
	/bin/rmdir /var/db/layer7/bl-update.lock /tmp/layer7-bl-update.lock \
		>/dev/null 2>&1 || true
fi
