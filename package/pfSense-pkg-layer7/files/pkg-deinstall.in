#!/bin/sh

reload_filter() {
	_php="/usr/local/bin/php"
	_filter_inc="/etc/inc/filter.inc"

	if [ -x "${_php}" ] && [ -f "${_filter_inc}" ]; then
		"${_php}" -r "require_once('${_filter_inc}'); if (function_exists('filter_configure')) { filter_configure(); }" >/dev/null 2>&1 || true
	fi
}

layer7_remove_crontabs() {
	_php="/usr/local/bin/php"
	if [ ! -x "${_php}" ] || [ ! -f "/usr/local/pkg/layer7.inc" ]; then
		return 0
	fi
	"${_php}" -r "
require_once('/etc/inc/filter.inc');
require_once('/etc/inc/service-utils.inc');
require_once('/usr/local/pkg/layer7.inc');
if (function_exists('layer7_bl_setup_cron')) {
	layer7_bl_setup_cron(false, 24);
}
if (function_exists('layer7_reports_setup_cron')) {
	layer7_reports_setup_cron(false, 5);
}
if (function_exists('layer7_mitm_setup_window_cron')) {
	layer7_mitm_setup_window_cron(false);
}
" >/dev/null 2>&1 || true
}

# Parar o daemon enquanto o rc.d ainda existe (POST-DEINSTALL corre depois da remocao).
if [ "${2}" = "PRE-DEINSTALL" ]; then
	/usr/sbin/service layer7-blockpage onestop >/dev/null 2>&1 || true
	/usr/sbin/service layer7-tlsproxy onestop >/dev/null 2>&1 || true
	/bin/rm -f /var/run/layer7/tlsproxy.product /var/run/layer7/mitm.effective \
		/var/run/layer7-tlsproxy.pid >/dev/null 2>&1 || true
	if command -v sysrc >/dev/null 2>&1; then
		sysrc layer7_tlsproxy_enable=NO >/dev/null 2>&1 || true
	fi
	/usr/local/bin/php -r "
require_once('/etc/inc/config.inc');
require_once('/usr/local/pkg/layer7.inc');
if (function_exists('layer7_remove_unbound_blockpage')) {
	layer7_remove_unbound_blockpage();
}
if (function_exists('layer7_remove_unbound_vip_dns')) {
	layer7_remove_unbound_vip_dns();
}
" >/dev/null 2>&1 || true
	/usr/sbin/service layer7d onestop >/dev/null 2>&1 || true
	layer7_remove_crontabs
	if [ -x /usr/local/libexec/layer7-pfctl ]; then
		/usr/local/libexec/layer7-pfctl flush-all >/dev/null 2>&1 || true
	fi
fi

/usr/local/bin/php -f /etc/rc.packages %%PORTNAME%% ${2}

if [ "${2}" = "POST-DEINSTALL" ]; then
	/bin/rm -f /var/run/layer7d.pid >/dev/null 2>&1 || true
	if command -v sysrc >/dev/null 2>&1; then
		sysrc layer7d_enable=NO >/dev/null 2>&1 || true
	fi
	reload_filter
	# Fallback pos-remocao (helper ja ausente): alinhar com layer7-pfctl flush-all
	for _t in layer7_block layer7_block_dst layer7_tagged layer7_bl_except \
	    layer7_allow_dst layer7_mitm_src layer7_mitm_dst layer7_mitm_dst6; do
		/sbin/pfctl -t "${_t}" -T flush >/dev/null 2>&1 || true
	done
	/bin/rm -f /var/run/layer7/tlsproxy.product /var/run/layer7/mitm.effective \
		/var/run/layer7-tlsproxy.pid >/dev/null 2>&1 || true
	if command -v sysrc >/dev/null 2>&1; then
		sysrc layer7_tlsproxy_enable=NO >/dev/null 2>&1 || true
	fi
	_i=0
	while [ "${_i}" -lt 32 ]; do
		/sbin/pfctl -t "layer7_bld_${_i}" -T flush >/dev/null 2>&1 || true
		/sbin/pfctl -t "layer7_blsrc_${_i}" -T flush >/dev/null 2>&1 || true
		_i=$((_i + 1))
	done
	_i=0
	while [ "${_i}" -lt 16 ]; do
		/sbin/pfctl -t "layer7_exc_allow_${_i}" -T flush >/dev/null 2>&1 || true
		_i=$((_i + 1))
	done
	_i=0
	while [ "${_i}" -lt 24 ]; do
		/sbin/pfctl -t "layer7_pdst_${_i}" -T flush >/dev/null 2>&1 || true
		/sbin/pfctl -t "layer7_psrc_${_i}" -T flush >/dev/null 2>&1 || true
		/sbin/pfctl -t "layer7_pallow_${_i}" -T flush >/dev/null 2>&1 || true
		/sbin/pfctl -t "layer7_pexc_${_i}" -T flush >/dev/null 2>&1 || true
		_i=$((_i + 1))
	done

	_profiles_custom_bak="/tmp/layer7-profiles-custom.json.bak"
	_keep_profiles_custom=0
	if [ -f /var/run/layer7-uninstall-keep-config ]; then
		_keep_profiles_custom=1
	elif [ -n "${PKG_UPGRADE:-}" ]; then
		_keep_profiles_custom=1
	fi
	if [ -f /usr/local/etc/layer7/profiles-custom.json ]; then
		/bin/cp -f /usr/local/etc/layer7/profiles-custom.json "${_profiles_custom_bak}" 2>/dev/null || true
	fi

	# Ficheiros de configuracao nao listados no plist (ou gerados em runtime)
	if [ -f /var/run/layer7-uninstall-keep-config ]; then
		/bin/rm -f /var/run/layer7-uninstall-keep-config
	elif [ -f /var/run/layer7-uninstall-keep-license ]; then
		/bin/rm -f /usr/local/etc/layer7.json >/dev/null 2>&1 || true
		/bin/rm -f /var/run/layer7-uninstall-keep-license
	else
		/bin/rm -f /usr/local/etc/layer7.json /usr/local/etc/layer7.lic >/dev/null 2>&1 || true
	fi
	# Cache blacklists, relatorios, estado — alinhado a scripts/release/uninstall.sh
	/bin/rm -rf /usr/local/etc/layer7 >/dev/null 2>&1 || true

	if [ "${_keep_profiles_custom}" -eq 1 ] && [ -f "${_profiles_custom_bak}" ]; then
		/bin/mkdir -p /usr/local/etc/layer7
		/bin/mv -f "${_profiles_custom_bak}" /usr/local/etc/layer7/profiles-custom.json 2>/dev/null || true
		chown www:wheel /usr/local/etc/layer7/profiles-custom.json 2>/dev/null || true
		chmod 0664 /usr/local/etc/layer7/profiles-custom.json 2>/dev/null || true
	elif [ -f "${_profiles_custom_bak}" ]; then
		/bin/rm -f "${_profiles_custom_bak}" >/dev/null 2>&1 || true
	fi

	/bin/rm -f /usr/local/etc/layer7-protos.txt >/dev/null 2>&1 || true
	/bin/rm -f /var/log/layer7d.log /var/log/layer7-events.log \
		/var/log/layer7-bl-update.log >/dev/null 2>&1 || true
	_i=1
	while [ "${_i}" -le 10 ]; do
		/bin/rm -f "/var/log/layer7d.log.${_i}" \
			"/var/log/layer7-events.log.${_i}" >/dev/null 2>&1 || true
		_i=$((_i + 1))
	done
	/bin/rm -f /tmp/layer7-stats.json /var/db/layer7/layer7-stats.json \
		/var/db/layer7/layer7-stats.json.tmp \
		/var/db/layer7/bl-progress.txt \
		/tmp/layer7-bl-progress.txt /tmp/layer7-bl-update.lock \
		/tmp/layer7-gh-latest.json /tmp/layer7-ndpi-protos.json \
		/var/db/layer7/gh-latest.json /var/db/layer7/ndpi-protos.json \
		/tmp/layer7_pkg_rm_started >/dev/null 2>&1 || true
	/bin/rmdir /var/db/layer7/bl-update.lock /tmp/layer7-bl-update.lock \
		>/dev/null 2>&1 || true
fi
