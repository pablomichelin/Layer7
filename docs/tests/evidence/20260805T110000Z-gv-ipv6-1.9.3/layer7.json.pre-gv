{
    "layer7": {
        "enabled": true,
        "mode": "enforce",
        "log_level": "info",
        "syslog_remote": false,
        "syslog_remote_host": "",
        "syslog_remote_port": 514,
        "debug_minutes": 0,
        "block_quic": false,
        "protos_file": "/usr/local/etc/layer7-protos.txt",
        "interfaces": [
            "vmx0",
            "vmx0.95"
        ],
        "groups": [],
        "policies": [
            {
                "id": "p-mon-001",
                "name": "Monitor geral",
                "enabled": true,
                "action": "monitor",
                "priority": 10,
                "match": []
            },
            {
                "id": "anti-bypass-dns",
                "name": "Anti-bypass DNS (DoH/DoT/Private Relay)",
                "enabled": true,
                "action": "block",
                "priority": 1,
                "match": {
                    "ndpi_app": [
                        "DoH_DoT",
                        "AppleiCloud",
                        "iCloudPrivateRelay"
                    ]
                }
            },
            {
                "id": "profile-preset-protecao-infantil",
                "name": "Protecao infantil",
                "enabled": true,
                "action": "block",
                "priority": 20,
                "match": {
                    "ndpi_app": [
                        "Psiphon",
                        "UltraSurf",
                        "CloudflareWarp",
                        "Tor",
                        "Badoo",
                        "AnyDesk"
                    ],
                    "ndpi_category": [
                        "AdultContent",
                        "Gambling",
                        "Dating"
                    ],
                    "hosts": [
                        "pornhub.com",
                        "xvideos.com",
                        "xhamster.com",
                        "redtube.com",
                        "youporn.com",
                        "xnxx.com",
                        "onlyfans.com",
                        "chaturbate.com",
                        "stripchat.com",
                        "livejasmin.com",
                        "spankbang.com",
                        "brazzers.com",
                        "eporner.com",
                        "rule34.xxx",
                        "xvideos2.com",
                        "tinder.com",
                        "bumble.com",
                        "grindr.com",
                        "bet365.com",
                        "betano.com",
                        "blaze.com",
                        "croxyproxy.com",
                        "hide.me",
                        "proxysite.com"
                    ]
                }
            },
            {
                "id": "profile-anti-bypass-dns",
                "name": "Anti-bypass DNS",
                "enabled": true,
                "action": "block",
                "priority": 20,
                "match": {
                    "ndpi_app": [
                        "DoH_DoT"
                    ],
                    "hosts": [
                        "mask.icloud.com",
                        "mask-h2.icloud.com",
                        "use-application-dns.net",
                        "dns.google",
                        "dns.google.com",
                        "cloudflare-dns.com",
                        "one.one.one.one",
                        "dns.quad9.net",
                        "dns.adguard.com",
                        "doh.opendns.com",
                        "doh.cleanbrowsing.org",
                        "dns.nextdns.io"
                    ]
                }
            }
        ],
        "exceptions": [],
        "license_key_mask": "a414b************",
        "language": "pt",
        "log_file_max_mb": 5,
        "log_file_keep": 3,
        "block_quic_interfaces": [],
        "block_dot_doq": false,
        "sni_inspection": false,
        "enforcement_model": "legacy_global",
        "reports": {
            "enabled": true,
            "retention_days": 7,
            "collect_interval": 5,
            "event_log_enabled": false,
            "event_retention_days": 7,
            "event_max_mb": 100,
            "event_interfaces": [
                "vmx0.95"
            ]
        },
        "block_page": {
            "enabled": true,
            "portal_ip": "",
            "title": "Acesso bloqueado",
            "message": "Este site ou servico foi bloqueado pela politica de rede do seu administrador.",
            "contact": "",
            "show_host": true,
            "show_policy": false,
            "sinkhole_blacklists": true,
            "blacklist_domain_limit": 256,
            "force_dns": true
        },
        "vip_meta": {
            "labels": []
        }
    }
}
